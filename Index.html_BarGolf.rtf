// \uc0\u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \
// LOCAL STORAGE\
// \uc0\u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \
function saveLocal() \{\
  try \{\
    const s = \{ ...state \};\
    delete s.photos; // don't store base64 photos in firebase, keep local only\
    localStorage.setItem('bargolf_v3', JSON.stringify(s));\
    // photos stored separately\
    const photos = \{\};\
    for (const k in state.photos) \{ try \{ localStorage.setItem('bgp_'+k, state.photos[k]); photos[k]=true; \} catch(e)\{\} \}\
    localStorage.setItem('bargolf_photokeys', JSON.stringify(Object.keys(photos)));\
  \} catch(e) \{\}\
\}\
\
function loadLocal() \{\
  try \{\
    const d = localStorage.getItem('bargolf_v3');\
    if (d) \{\
      const s = JSON.parse(d);\
      Object.assign(state, s);\
      // load photos\
      const keys = JSON.parse(localStorage.getItem('bargolf_photokeys')||'[]');\
      state.photos = \{\};\
      keys.forEach(k=>\{ const p=localStorage.getItem('bgp_'+k); if(p) state.photos[k]=p; \});\
    \}\
  \} catch(e) \{\}\
\}\
\
// \uc0\u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \
// LOBBY\
// \uc0\u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \
function renderLobby() \{\
  document.getElementById('lobby-code').textContent = state.roundCode || '----';\
  document.getElementById('lobby-players-title').textContent = `Players ($\{state.players.length\})`;\
\
  document.getElementById('lobby-player-list').innerHTML = state.players.map((p,i)=>`\
    <div class="flex items-center gap-8" style="padding:8px 0;border-bottom:1px solid var(--border);">\
      <div class="avatar" style="$\{avatarStyle(i)\}">$\{initials(p)\}</div>\
