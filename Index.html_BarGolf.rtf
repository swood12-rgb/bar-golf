\
// \uc0\u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \
// STATE\
// \uc0\u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \
const PAR = 3;\
const COLORS = [\
  \{ bg:'rgba(106,76,147,0.25)', text:'#e8d5fb' \},\
  \{ bg:'rgba(82,183,136,0.2)',  text:'#d8f3dc' \},\
  \{ bg:'rgba(233,196,106,0.15)',text:'#fae8a0' \},\
  \{ bg:'rgba(230,57,70,0.15)',  text:'#ffb3b8' \},\
  \{ bg:'rgba(56,142,210,0.2)',  text:'#bde0ff' \},\
  \{ bg:'rgba(255,180,0,0.15)',  text:'#ffe8a0' \},\
  \{ bg:'rgba(0,200,180,0.15)',  text:'#a0fff4' \},\
  \{ bg:'rgba(255,100,80,0.15)', text:'#ffc8b8' \},\
];\
\
let state = \{\
  roundCode: null,\
  roundName: '',\
  numHoles: 9,\
  players: [],\
  scores: \{\},\
  barNames: \{\},\
  photos: \{\},\
  currentHole: 0,\
  isHost: false\
\};\
let roundRef = null;\
let unsubscribe = null;\
\
function initials(n) \{ return (n||'?').trim().split(' ').map(w=>w[0]).join('').toUpperCase().slice(0,2)||'?'; \}\
function avatarStyle(i) \{ const c=COLORS[i%COLORS.length]; return `background:$\{c.bg\};color:$\{c.text\};border:1px solid $\{c.text\}30;`; \}\
\
// \uc0\u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \
// NAVIGATION\
// \uc0\u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \
function goTo(screen) \{\
  document.querySelectorAll('.screen').forEach(s=>s.classList.remove('active'));\
  document.getElementById('screen-'+screen).classList.add('active');\
  window.scrollTo(0,0);\
  if (screen==='lobby') renderLobby();\
  if (screen==='scoring') renderScoring();\
  if (screen==='leaderboard') renderLeaderboard();\
  if (screen==='summary') renderSummary();\
\}\
\
// \uc0\u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \
// ROUND CODE\
// \uc0\u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \
function genCode() \{\
  const chars='ABCDEFGHJKLMNPQRSTUVWXYZ23456789';\
  return Array.from(\{length:4\},()=>chars[Math.floor(Math.random()*chars.length)]).join('');\
\}\
\
// \uc0\u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \
// CREATE SCREEN\
// \uc0\u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \
let createPlayers = [];\
\
function addCreatePlayer() \{\
  createPlayers.push(\{ name: '' \});\
  renderCreatePlayers();\
  setTimeout(()=>\{ const inputs=document.querySelectorAll('#create-players input'); inputs[inputs.length-1]?.focus(); \},50);\
\}\
\
function renderCreatePlayers() \{\
  const el = document.getElementById('create-players');\
  if (!createPlayers.length) \{\
    el.innerHTML = '<p class="text-sm text-muted" style="padding:8px 0;">Add at least one player to start</p>';\
    return;\
  \}\
  el.innerHTML = createPlayers.map((p,i)=>`\
    <div class="flex items-center gap-8" style="padding:6px 0;border-bottom:1px solid var(--border);">\
      <div class="avatar" style="$\{avatarStyle(i)\}">$\{p.name?initials(p.name):i+1\}</div>\
      <input type="text" value="$\{p.name\}" placeholder="Player $\{i+1\}" style="flex:1;" oninput="createPlayers[$\{i\}].name=this.value;updateAvatarPreview($\{i\})" />\
      <button class="btn btn-danger btn-icon" onclick="removeCreatePlayer($\{i\})">\
        <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M3 6h18M8 6V4h8v2M19 6l-1 14H6L5 6"/></svg>\
      </button>\
    </div>`).join('');\
\}\
\
function updateAvatarPreview(i) \{\
  const avatars = document.querySelectorAll('#create-players .avatar');\
  if (avatars[i]) avatars[i].textContent = createPlayers[i].name ? initials(createPlayers[i].name) : i+1;\
\}\
\
function removeCreatePlayer(i) \{ createPlayers.splice(i,1); renderCreatePlayers(); \}\
\
async function createRound() \{\
  const names = createPlayers.map(p=>p.name.trim()||`Player $\{createPlayers.indexOf(p)+1\}`);\
  if (!names.length) \{ showToast('Add at least one player!'); return; \}\
\
  const code = genCode();\
  state.roundCode = code;\
  state.roundName = document.getElementById('create-name').value || 'Bar Golf';\
  state.numHoles = parseInt(document.getElementById('create-holes').value);\
  state.players = names;\
  state.scores = \{\};\
  state.barNames = \{\};\
  state.photos = \{\};\
  state.currentHole = 0;\
  state.isHost = true;\
\
  if (!offlineMode && db) \{\
    roundRef = db.ref('rounds/'+code);\
    await roundRef.set(\{\
      name: state.roundName,\
      numHoles: state.numHoles,\
      players: state.players,\
      scores: \{\},\
      barNames: \{\},\
      currentHole: 0,\
      createdAt: Date.now()\
    \});\
    listenToRound();\
  \}\
\
  saveLocal();\
  goTo('lobby');\
\}\
\
// \uc0\u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \
// JOIN ROUND\
// \uc0\u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \
async function joinRound() \{\
  const code = document.getElementById('join-code-input').value.trim().toUpperCase();\
  if (code.length < 3) \{ showToast('Enter a valid code'); return; \}\
\
  if (offlineMode) \{ showToast('Offline mode \'97 sharing not available'); return; \}\
\
  const snap = await db.ref('rounds/'+code).once('value');\
  if (!snap.exists()) \{ showToast('Round not found!'); return; \}\
\
  const data = snap.val();\
  state.roundCode = code;\
  state.roundName = data.name || 'Bar Golf';\
  state.numHoles = data.numHoles || 9;\
  state.players = data.players || [];\
  state.scores = data.scores || \{\};\
  state.barNames = data.barNames || \{\};\
  state.photos = \{\};\
  state.currentHole = data.currentHole || 0;\
  state.isHost = false;\
\
  roundRef = db.ref('rounds/'+code);\
  listenToRound();\
  saveLocal();\
  goTo('scoring');\
\}\
\
// \uc0\u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \
// FIREBASE SYNC\
// \uc0\u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \
function listenToRound() \{\
  if (!roundRef) return;\
  if (unsubscribe) unsubscribe();\
  const listener = roundRef.on('value', snap => \{\
    if (!snap.exists()) return;\
    const d = snap.val();\
    state.players = d.players || state.players;\
    state.numHoles = d.numHoles || state.numHoles;\
    state.scores = d.scores || \{\};\
    state.barNames = d.barNames || \{\};\
    const activeScreen = document.querySelector('.screen.active')?.id;\
    if (activeScreen==='screen-lobby') renderLobby();\
    if (activeScreen==='screen-scoring') renderScoring();\
    if (activeScreen==='screen-leaderboard') renderLeaderboard();\
    if (activeScreen==='screen-summary') renderSummary();\
  \});\
  unsubscribe = () => roundRef.off('value', listener);\
\}\
\
async function pushToFirebase() \{\
  if (offlineMode || !roundRef) return;\
  await roundRef.update(\{\
    scores: state.scores,\
    barNames: state.barNames,\
    currentHole: state.currentHole,\
    players: state.players\
  \});\
\}\
