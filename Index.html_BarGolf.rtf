  \} catch(e) \{\
    qrEl.innerHTML = `<p class="text-sm text-muted">$\{url\}</p>`;\
  \}\
\}\
\
function copyCode() \{\
  const url = `$\{location.origin\}$\{location.pathname\}?join=$\{state.roundCode\}`;\
  navigator.clipboard.writeText(url).then(()=>showToast('Link copied!')).catch(()=>showToast(url));\
\}\
\
function startScoring() \{ goTo('scoring'); \}\
\
// \uc0\u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \
// SCORING\
// \uc0\u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \
function renderScoring() \{\
  const h = state.currentHole;\
  const bn = state.barNames[h] || '';\
  document.getElementById('scoring-hole-title').textContent = `HOLE $\{h+1\} OF $\{state.numHoles\}`;\
  document.getElementById('scoring-subtitle').textContent = `$\{bn || 'Bar '+(h+1)\} \'b7 Par $\{PAR\} sips`;\
  document.getElementById('scoring-bar-name').value = bn;\
\
  // Dots\
  document.getElementById('scoring-dots').innerHTML =\
    Array.from(\{length:state.numHoles\},(_,i)=>\{\
      const cls = i===h?'current':(state.scores[i]?'done':'');\
      return `<div class="hole-dot $\{cls\}" onclick="jumpHole($\{i\})" title="Hole $\{i+1\}"></div>`;\
    \}).join('');\
\
  // Players\
  document.getElementById('scoring-players').innerHTML = state.players.map((p,pi)=>\{\
    const cur = state.scores[h]?.[pi];\
    const photoKey = `$\{h\}_$\{pi\}`;\
    const photo = state.photos?.[photoKey];\
    const verified = !!photo;\
\
    const sipBtns = [1,2,3,4,5,6].map(n=>\{\
      let selCls='';\
      if(cur===n) selCls = n===1?'sel-1':n===2?'sel-2':n===3?'sel-3':n===4?'sel-4':'sel-high';\
      const lbl = n===1?'\uc0\u55357 \u56691 \u65039 ':n===2?'\u55357 \u56358 ':n===3?'\u9971 ':n===4?'+1':n===5?'+2':'+3';\
      return `<button class="sip-btn $\{selCls\}" onclick="setScore($\{h\},$\{pi\},$\{n\})">\
        <span>$\{n\}</span>\
        <span class="sip-label">$\{lbl\}</span>\
      </button>`;\
    \}).join('');\
\
    const verBadge = cur!=null ? (verified\
      ? '<span class="badge badge-green">\uc0\u55357 \u56567  verified</span>'\
      : '<span class="badge badge-amber">\uc0\u55357 \u56567  unverified</span>')\
      : '';\
\
    const photoHtml = cur!=null ? (photo\
      ? `<div class="flex items-center gap-8" style="margin-top:10px;">\
           <img src="$\{photo\}" class="photo-thumb" onclick="removePhoto($\{h\},$\{pi\})" title="Tap to remove" />\
           <span class="text-xs text-muted">Tap photo to remove</span>\
         </div>`\
      : `<label class="photo-upload-area">\
           <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/><circle cx="12" cy="13" r="4"/></svg>\
           Upload empty glass proof\
           <input type="file" accept="image/*" capture="environment" style="display:none;" onchange="handlePhoto(event,$\{h\},$\{pi\})" />\
         </label>`)\
      : '';\
\
    return `<div class="player-block">\
      <div class="flex items-center justify-between mb-8">\
        <div class="flex items-center gap-8">\
          <div class="avatar" style="$\{avatarStyle(pi)\}">$\{initials(p)\}</div>\
          <span class="fw-500">$\{p\}</span>\
        </div>\
        $\{verBadge\}\
      </div>\
      <div class="sip-grid">$\{sipBtns\}</div>\
      $\{photoHtml\}\
    </div>`;\
  \}).join('');\
\
  // Next / finish button\
  const nextBtn = document.getElementById('btn-next');\
  document.getElementById('btn-prev').disabled = h===0;\
  if (h===state.numHoles-1) \{\
    nextBtn.innerHTML = 'Finish round <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>';\
    nextBtn.onclick = ()=>goTo('summary');\
  \} else \{\
    nextBtn.innerHTML = 'Next hole <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"/></svg>';\
    nextBtn.onclick = nextHole;\
  \}\
\}\
\
function saveBarName() \{\
  const h = state.currentHole;\
  state.barNames[h] = document.getElementById('scoring-bar-name').value;\
  document.getElementById('scoring-subtitle').textContent = `$\{state.barNames[h]||'Bar '+(h+1)\} \'b7 Par $\{PAR\} sips`;\
  saveLocal(); pushToFirebase();\
\}\
\
function setScore(hole, pi, val) \{\
  if (!state.scores[hole]) state.scores[hole] = \{\};\
  state.scores[hole][pi] = val;\
  saveLocal(); pushToFirebase(); renderScoring();\
\}\
\
function handlePhoto(e, hole, pi) \{\
  const file = e.target.files[0]; if (!file) return;\
  const reader = new FileReader();\
  reader.onload = ev => \{\
    if (!state.photos) state.photos=\{\};\
    state.photos[`$\{hole\}_$\{pi\}`] = ev.target.result;\
    saveLocal(); renderScoring();\
  \};\
  reader.readAsDataURL(file);\
\}\
\
function removePhoto(hole, pi) \{\
  if (state.photos) \{ delete state.photos[`$\{hole\}_$\{pi\}`]; try \{ localStorage.removeItem(`bgp_$\{hole\}_$\{pi\}`); \} catch(e)\{\} \}\
  saveLocal(); renderScoring();\
\}\
\
function nextHole() \{\
  if (state.currentHole < state.numHoles-1) \{\
    state.currentHole++; saveLocal(); pushToFirebase(); renderScoring();\
  \}\
\}\
\
function prevHole() \{\
  if (state.currentHole>0) \{\
    state.currentHole--; saveLocal(); pushToFirebase(); renderScoring();\
  \}\
\}\
\
function jumpHole(i) \{ state.currentHole=i; saveLocal(); pushToFirebase(); renderScoring(); \}\
\
// \uc0\u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \
// LEADERBOARD\
// \uc0\u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \
function getTotals() \{\
  return state.players.map((p,pi)=>\{\
    let total=0,played=0;\
    for(let h=0;h<state.numHoles;h++)\{\
      const s=state.scores[h]?.[pi];\
      if(s!==undefined)\{total+=s;played++;\}\
    \}\
    const verified = Object.keys(state.photos||\{\}).filter(k=>k.startsWith(`$\{state.currentHole\}_$\{pi\}`) || true).filter(k=>\{\
      const parts=k.split('_'); return parts[1]===String(pi) && parseInt(parts[0])<state.numHoles;\
    \}).length;\
    const totalVerified = Object.keys(state.photos||\{\}).filter(k=>\{ const p2=k.split('_'); return p2[1]===String(pi); \}).length;\
    return \{name:p,idx:pi,total,played,verified:totalVerified\};\
  \}).sort((a,b)=>\{\
    if(!a.played&&!b.played) return 0;\
    if(!a.played) return 1; if(!b.played) return -1;\
    return a.total-b.total;\
  \});\
\}\
\
function relPar(total,holes) \{\
  const diff=total-(holes*PAR);\
  if(diff<=-holes) return \{label:'\uc0\u55357 \u56691 \u65039 ',cls:'badge-purple'\};\
  if(diff<0) return \{label:diff,cls:'badge-green'\};\
  if(diff===0) return \{label:'E',cls:'badge-gray'\};\
  if(diff===1) return \{label:'+1',cls:'badge-amber'\};\
  return \{label:'+'+diff,cls:'badge-red'\};\
\}\
\
function cellClass(s) \{\
  if(s===1) return 'sc-hole-in-one';\
  if(s===2) return 'sc-birdie';\
  if(s===3) return 'sc-par';\
  if(s===4) return 'sc-bogey';\
  return 'sc-double';\
\}\
\
function renderLeaderboard() \{\
  const sorted = getTotals();\
  document.getElementById('lb-list').innerHTML = sorted.map((p,rank)=>\{\
    const rel = p.played>0?relPar(p.total,p.played):null;\
    return `<div class="lb-row">\
      <div class="lb-rank">$\{p.played>0?rank+1:'\'96'\}</div>\
      <div class="avatar" style="$\{avatarStyle(p.idx)\}">$\{initials(p.name)\}</div>\
      <div>\
        <div class="lb-name">$\{p.name\}</div>\
        <div class="lb-holes">$\{p.played\}/$\{state.numHoles\} holes \'b7 \uc0\u55357 \u56567  $\{p.verified\}</div>\
      </div>\
      $\{rel?`<span class="badge $\{rel.cls\}">$\{rel.label\}</span>`:'<span></span>'\}\
      <div class="lb-score">$\{p.played>0?p.total:'\'96'\}</div>\
    </div>`;\
  \}).join('');\
\
  // Scorecard\
  const hdrCells = Array.from(\{length:state.numHoles\},(_,i)=>`<th>$\{state.barNames[i]?(state.barNames[i].slice(0,4)):i+1\}</th>`).join('');\
  const parRow = `<tr style="opacity:0.6;"><td style="text-align:left;padding:6px 4px;font-size:11px;color:var(--text3);">Par</td>$\{Array.from(\{length:state.numHoles\},()=>`<td class="sc-par"><span class="sc-cell">$\{PAR\}</span></td>`).join('')\}<td style="font-weight:600;">$\{state.numHoles*PAR\}</td></tr>`;\
  const rows = state.players.map((p,pi)=>\{\
    const cells = Array.from(\{length:state.numHoles\},(_,h)=>\{\
      const s=state.scores[h]?.[pi];\
      if(s===undefined) return '<td>\'96</td>';\
      return `<td><span class="sc-cell $\{cellClass(s)\}">$\{s\}</span></td>`;\
    \}).join('');\
    let tot=0,played=0;\
    for(let h=0;h<state.numHoles;h++)\{const s=state.scores[h]?.[pi];if(s!==undefined)\{tot+=s;played++;\}\}\
    return `<tr><td style="text-align:left;padding:6px 4px;font-size:13px;white-space:nowrap;">$\{p\}</td>$\{cells\}<td style="font-weight:600;font-family:var(--font-mono);">$\{played>0?tot:'\'96'\}</td></tr>`;\
  \}).join('');\
  document.getElementById('scorecard').innerHTML = `<thead><tr><th style="text-align:left;">Player</th>$\{hdrCells\}<th>Tot</th></tr>$\{parRow\}</thead><tbody>$\{rows\}</tbody>`;\
\}\
\
function switchTab(tab) \{\
  document.getElementById('tab-live-btn').classList.toggle('active',tab==='live');\
  document.getElementById('tab-card-btn').classList.toggle('active',tab==='card');\
  document.getElementById('tab-live').style.display=tab==='live'?'block':'none';\
  document.getElementById('tab-card').style.display=tab==='card'?'block':'none';\
\}\
\
// \uc0\u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \
// SUMMARY\
// \uc0\u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \
function renderSummary() \{\
  const sorted = getTotals();\
  const winner = sorted[0];\
  const totalPar = state.numHoles*PAR;\
  let html='';\
\
  if(winner&&winner.played>0) \{\
    const diff=winner.total-totalPar;\
    html+=`<div class="winner-banner">\
      <div class="winner-trophy">\uc0\u55356 \u57286 </div>\
      <div class="winner-name">$\{winner.name\}</div>\
      <p class="text-sm text-muted" style="margin-top:6px;">$\{winner.total\} sips total \'b7 $\{diff===0?'Even par':diff>0?'+'+diff+' over par':Math.abs(diff)+' under par'\}</p>\
    </div>`;\
  \}\
\
  html+=`<div class="stat-grid">\
    <div class="stat-card"><div class="stat-val">$\{state.players.length\}</div><div class="stat-lbl">Players</div></div>\
    <div class="stat-card"><div class="stat-val">$\{state.numHoles\}</div><div class="stat-lbl">Holes</div></div>\
    <div class="stat-card"><div class="stat-val">$\{totalPar\}</div><div class="stat-lbl">Par total</div></div>\
  </div>`;\
\
  html+=`<div class="card"><h3>Final standings</h3>`;\
  html+=sorted.map((p,i)=>\{\
    const rel=p.played>0?relPar(p.total,p.played):null;\
    const medal=['\uc0\u55358 \u56647 ','\u55358 \u56648 ','\u55358 \u56649 '][i]||(i+1+'.');\
    return `<div class="lb-row">\
      <div style="font-size:$\{i<3?'20px':'14px'\};text-align:center;">$\{medal\}</div>\
      <div class="avatar" style="$\{avatarStyle(p.idx)\}">$\{initials(p.name)\}</div>\
      <div>\
        <div class="lb-name">$\{p.name\}</div>\
        <div class="lb-photos">\uc0\u55357 \u56567  $\{p.verified\} verified</div>\
      </div>\
      $\{rel?`<span class="badge $\{rel.cls\}">$\{rel.label\}</span>`:'<span></span>'\}\
      <div class="lb-score">$\{p.played>0?p.total:'\'96'\}</div>\
    </div>`;\
  \}).join('');\
  html+=`</div>`;\
\
  document.getElementById('summary-content').innerHTML=html;\
\}\
