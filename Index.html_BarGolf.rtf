\
  /* Nav */\
  .nav-bar \{ display: flex; align-items: center; gap: 10px; margin-bottom: 20px; \}\
  .nav-bar .nav-title \{ flex: 1; \}\
\
  /* Tabs */\
  .tabs \{ display: flex; gap: 2px; background: var(--bg2); border-radius: var(--r-sm); padding: 3px; margin-bottom: 16px; \}\
  .tab-btn \{ flex: 1; padding: 8px; border-radius: 6px; background: transparent; border: none; color: var(--text3); font-family: var(--font-body); font-size: 13px; font-weight: 500; cursor: pointer; transition: all 0.15s; \}\
  .tab-btn.active \{ background: var(--surface2); color: var(--text); \}\
\
  /* QR section */\
  #qr-container \{ display: flex; justify-content: center; padding: 16px; \}\
  #qr-container canvas, #qr-container img \{ border-radius: 8px; \}\
\
  /* Join code display */\
  .join-code \{ font-family: var(--font-head); font-size: 52px; letter-spacing: 8px; text-align: center; color: var(--amber); padding: 12px; \}\
\
  /* Stat cards */\
  .stat-grid \{ display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; margin-bottom: 12px; \}\
  .stat-card \{ background: var(--bg2); border-radius: var(--r-sm); padding: 12px; text-align: center; \}\
  .stat-val \{ font-family: var(--font-head); font-size: 28px; color: var(--text); \}\
  .stat-lbl \{ font-size: 11px; color: var(--text3); text-transform: uppercase; letter-spacing: 0.5px; margin-top: 2px; \}\
\
  /* Toast */\
  #toast \{\
    position: fixed; bottom: 24px; left: 50%; transform: translateX(-50%) translateY(20px);\
    background: var(--surface2); border: 1px solid var(--border2); border-radius: var(--r-sm);\
    padding: 10px 20px; font-size: 13px; color: var(--text2); z-index: 999;\
    opacity: 0; transition: all 0.25s; pointer-events: none; white-space: nowrap;\
  \}\
  #toast.show \{ opacity: 1; transform: translateX(-50%) translateY(0); \}\
\
  /* Loader */\
  .loader \{ display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 16px; padding: 60px 0; color: var(--text3); \}\
  .spinner \{ width: 32px; height: 32px; border: 2px solid var(--border2); border-top-color: var(--green-light); border-radius: 50%; animation: spin 0.7s linear infinite; \}\
  @keyframes spin \{ to \{ transform: rotate(360deg); \} \}\
\
  /* Winner banner */\
  .winner-banner \{ text-align: center; padding: 24px 16px; background: linear-gradient(135deg, rgba(45,106,79,0.3), rgba(82,183,136,0.1)); border: 1px solid rgba(82,183,136,0.3); border-radius: var(--r); margin-bottom: 16px; \}\
  .winner-trophy \{ font-size: 48px; margin-bottom: 8px; \}\
  .winner-name \{ font-family: var(--font-head); font-size: 36px; color: var(--amber); \}\
\
  /* Divider */\
  .divider \{ height: 1px; background: var(--border); margin: 16px 0; \}\
\
  /* Firebase config notice */\
  .config-notice \{ background: rgba(233,196,106,0.1); border: 1px solid rgba(233,196,106,0.3); border-radius: var(--r-sm); padding: 14px; margin-bottom: 16px; \}\
  .config-notice p \{ font-size: 13px; color: var(--amber); margin-bottom: 4px; \}\
  .config-notice code \{ font-family: var(--font-mono); font-size: 11px; color: var(--text2); \}\
\
  /* Scrollable overflow area */\
  .overflow-x \{ overflow-x: auto; \}\
\
  /* Utility */\
  .flex \{ display: flex; \}\
  .items-center \{ align-items: center; \}\
  .justify-between \{ justify-content: space-between; \}\
  .gap-8 \{ gap: 8px; \}\
  .gap-12 \{ gap: 12px; \}\
  .mb-4 \{ margin-bottom: 4px; \}\
  .mb-8 \{ margin-bottom: 8px; \}\
  .mb-12 \{ margin-bottom: 12px; \}\
  .mb-16 \{ margin-bottom: 16px; \}\
  .mb-24 \{ margin-bottom: 24px; \}\
  .text-muted \{ color: var(--text2); \}\
  .text-sm \{ font-size: 13px; \}\
  .text-xs \{ font-size: 11px; \}\
  .fw-500 \{ font-weight: 500; \}\
  .w-full \{ width: 100%; \}\
</style>\
</head>\
